[
  "Damlaya damlaya göl olur.",
  "Sabır acıdır, meyvesi tatlıdır.",
  "Bugünün işini yarına bırakma.",
  "Emek olmadan yemek olmaz.",
  "İşleyen demir ışıldar.",
  "Ağaç yaşken eğilir.",
  "Akıl akıldan üstündür.",
  "Bilmemek ayıp değil, öğrenmemek ayıp.",
  "Gülme komşuna, gelir başına.",
  "Tatlı dil yılanı deliğinden çıkarır.",
  "Her işte bir hayır vardır.",
  "Yavaş yavaş, yol alır kervan.",
  "Sakla samanı, gelir zamanı.",
  "Ak akçe kara gün içindir.",
  "Az olsun, öz olsun.",
  "Birlikten kuvvet doğar.",
  "Bir elin nesi var, iki elin sesi var.",
  "Yuvarlanan taş yosun tutmaz.",
  "Ne ekersen onu biçersin.",
  "Erken kalkan yol alır.",
  "Dost kara günde belli olur.",
  "Görünen köy kılavuz istemez.",
  "Su aktığı yere akar.",
  "Ölçüp biçmeden işe başlama.",
  "Yedi kere ölç, bir kere kes.",
  "Çok bilen çok yanılır.",
  "Söz gümüşse sükût altındır.",
  "Komşu komşunun külüne muhtaçtır.",
  "Bin bilsen de bir bilene danış.",
  "Haydan gelen huya gider.",
  "Gönül ne kahve ister ne kahvehane, gönül sohbet ister.",
  "Üzüm üzüme baka baka kararır.",
  "Kervan yolda düzülür.",
  "Rüzgâr eken fırtına biçer.",
  "Acele işe şeytan karışır.",
  "Sabreden derviş muradına ermiş.",
  "Gün doğmadan neler doğar.",
  "Dereyi görmeden paçaları sıvama.",
  "Ateş düştüğü yeri yakar.",
  "İyilik yap denize at, balık bilmezse Halik bilir.",
  "Her yokuşun bir inişi vardır.",
  "Bir mum ile bin mum yanar, ışığından bir şey eksilmez.",
  "Usta olmak için çırak olmak gerekir.",
  "El elden üstündür.",
  "Kişi bildiği işte ustadır.",
  "Su testisi su yolunda kırılır.",
  "Ne kadar yavaş gittiğin önemli değil, yeter ki durma.",
  "Küçük adımlar büyük yolların başlangıcıdır.",
  "Bugün attığın tohum, yarının gölgesidir.",
  "İyi bir gün, iyi bir sabahla başlar."
]
